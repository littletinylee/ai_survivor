[configuration]
entry_symbol = "ai_survivors_library_init"
compatibility_minimum = "4.7.2"

[libraries]
windows.debug.x86_64 = "res://bin/ai_survivors.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/ai_survivors.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libai_survivors.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libai_survivors.linux.template_release.x86_64.so"
